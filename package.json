{
  "name": "chatim-web-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup-dev": "pnpm install && pnpm codegen",
    "dev": "pnpm --filter @chatim/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "codegen": "pnpm --filter @chatim/sdk codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.7.2"
  }
}
